{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegghost.stegverse.org/schemas/receipt-chain.schema.json",
  "title": "StegGhost Organizational Boundary Receipt Chain",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "receipts",
    "reconstruction"
  ],
  "properties": {
    "schema_version": {
      "const": "stegghost.boundary-receipts.v1"
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "receipt_id",
          "observed_at",
          "subject",
          "evidence_hash"
        ],
        "properties": {
          "kind": {
            "enum": [
              "INGRESS_ACCEPTED",
              "DISPATCHED",
              "CONSUMED",
              "RESULT_BOUND",
              "EGRESS_EMITTED"
            ]
          },
          "receipt_id": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "evidence_hash": {
            "type": "string",
            "minLength": 1
          },
          "previous_receipt_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "reconstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "same_execution_required",
        "status"
      ],
      "properties": {
        "same_execution_required": {
          "const": true
        },
        "status": {
          "enum": [
            "NOT_ATTEMPTED",
            "PARTIAL",
            "RECONSTRUCTED",
            "FAILED"
          ]
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
