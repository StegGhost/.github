{
  "schema_version": "stegverse.org-resident-runtime.activation.v1",
  "organization": "StegGhost",
  "canonical_repository": "StegGhost/.github",
  "activation_owner": "StegGhost/.github",
  "entrypoint": "resident-runtime/run_once.py",
  "ingress_egress_owner": "StegGhost/.github",
  "intr_transport": "org-boundary/runtime/intr_transport.py",
  "boundary_processor": "org-boundary/runtime/process_boundary.py",
  "state": "UNIVERSAL_KERNEL_NETWORK_FEDERATION_SOURCE_INSTALLED_OBSERVATION_PENDING",
  "github_actions_is_runtime_authority": false,
  "hb_carrier_grants_authority": false,
  "application_repositories_are_activation_authority": false,
  "kernel": {
    "version": "1.3.1",
    "path": "org-kernel/kernel.py",
    "canonical_source": "StegVerse-Labs/.github/org-kernel",
    "vendored": true
  },
  "ecosystem_control": "resident-runtime/ecosystem_control.py",
  "federation_cycle": "resident-runtime/federation_cycle.py",
  "federation_directory": "org-boundary/registry/federation.json",
  "federation_gateway_transport": "resident-runtime/federation_gateway_transport.py",
  "federation_gateway_url_env": "STEGVERSE_ORG_FEDERATION_GATEWAY_URL",
  "federation_gateway_required_for_cross_host": false,
  "local_spool_scope": "REPO_LOCAL_ONLY_ROUTE",
  "resident_cycle_entrypoint": "resident-runtime/federation_cycle.py",
  "federation_poll_mode": "OUTBOUND_ONLY",
  "federation_network_route": "REPO_LOCAL_SPOOL",
  "epoch_bindings": {
    "resident-runtime/federation_cycle.py": {
      "hb_epoch": {
        "from": "committed_request",
        "cli_flag": "--hb-epoch",
        "env": "HB_EPOCH",
        "rule": "SUBMISSION_CARRIES_THE_SUPPLIED_HB_EPOCH",
        "absent_or_invalid": "six-field FAIL_CLOSED HB_EPOCH_NOT_SUPPLIED / HB_EPOCH_INVALID, rc 1, nothing written",
        "derived_from_clock": false
      },
      "dispatcher": {
        "kind": "COMMITTED_REQUEST",
        "workflow": ".github/workflows/resident-federation-cycle.yml",
        "request": ".stegverse/federation-cycle/request.json",
        "input": "hb_epoch",
        "ledger_head": "refs/stegverse/organization-ledger",
        "invocation": "python resident-runtime/federation_cycle.py --hb-epoch \"$HB_EPOCH\"",
        "empty_or_absent_input": "HB_EPOCH_NOT_SUPPLIED, refused before the cycle runs",
        "ledger_head_absent_or_mismatched": "LEDGER_HEAD_NOT_SUPPLIED / LEDGER_HEAD_INVALID, refused before the cycle runs",
        "in_tree": true,
        "adds_dependency": false
      }
    }
  }
}
